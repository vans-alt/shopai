# Optional - enables the LLM chatbot (Azure OpenAI). Leave blank for rule-based replies.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Databases (docker compose reads these; defaults in docker-compose.yml are for LOCAL use only)
MYSQL_ROOT_PASSWORD=root_pw
MYSQL_PASSWORD=shopai_pw
# Lets you add products with POST /api/products (header X-Admin-Key). Leave blank to disable.
ADMIN_KEY=
